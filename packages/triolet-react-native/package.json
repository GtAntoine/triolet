{
  "name": "triolet-react-native",
  "version": "0.1.1",
  "description": "Animated icons in three colours for React Native and Expo, drawn with Skia and moved by Reanimated.",
  "keywords": [
    "react-native",
    "expo",
    "icons",
    "animated-icons",
    "skia",
    "reanimated",
    "neumorphism",
    "three-colours"
  ],
  "license": "MIT",
  "author": "Antoine Goethals (https://github.com/GtAntoine)",
  "homepage": "https://gtantoine.github.io/triolet/",
  "bugs": {
    "url": "https://github.com/GtAntoine/triolet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GtAntoine/triolet.git",
    "directory": "packages/triolet-react-native"
  },
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "react-native": "src/index.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "browser": "./src/index.web.ts",
      "default": "./src/index.ts"
    },
    "./icons/*": {
      "types": "./src/icons/*.ts",
      "default": "./src/icons/*.ts"
    }
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../tools/build-packages.ts triolet-react-native"
  },
  "dependencies": {
    "triolet": "workspace:^"
  },
  "peerDependencies": {
    "@shopify/react-native-skia": ">=2.14.0",
    "react": ">=19.0.0",
    "react-native": ">=0.80.0",
    "react-native-reanimated": ">=4.0.0",
    "triolet-react": "workspace:^"
  },
  "peerDependenciesMeta": {
    "triolet-react": {
      "optional": true
    }
  }
}

{
  "name": "triolet-react",
  "version": "0.1.1",
  "description": "Animated icons in three colours as React components: one component per icon, CSS motion, no animation library.",
  "keywords": [
    "react",
    "icons",
    "animated-icons",
    "svg",
    "css-animation",
    "neumorphism",
    "design-system",
    "three-colours"
  ],
  "license": "MIT",
  "author": "Antoine Goethals (https://github.com/GtAntoine)",
  "homepage": "https://gtantoine.github.io/triolet/",
  "bugs": {
    "url": "https://github.com/GtAntoine/triolet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GtAntoine/triolet.git",
    "directory": "packages/triolet-react"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./icons/*": {
      "types": "./dist/icons/*.d.ts",
      "default": "./dist/icons/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../tools/build-packages.ts triolet-react"
  },
  "dependencies": {
    "triolet": "workspace:^"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}

{
  "name": "triolet",
  "version": "0.1.1",
  "description": "Animated icons in three colours (base, main, accent) with a soft relief: SVG and CSS motion, no dependency.",
  "keywords": [
    "icons",
    "animated-icons",
    "svg",
    "css-animation",
    "neumorphism",
    "design-system",
    "three-colours",
    "theming"
  ],
  "license": "MIT",
  "author": "Antoine Goethals (https://github.com/GtAntoine)",
  "homepage": "https://gtantoine.github.io/triolet/",
  "bugs": {
    "url": "https://github.com/GtAntoine/triolet/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GtAntoine/triolet.git",
    "directory": "packages/triolet"
  },
  "type": "module",
  "main": "./dist/triolet/src/index.js",
  "types": "./dist/triolet/src/index.d.ts",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/triolet/src/index.d.ts",
      "default": "./dist/triolet/src/index.js"
    },
    "./runtime": {
      "types": "./dist/triolet/src/runtime.d.ts",
      "default": "./dist/triolet/src/runtime.js"
    },
    "./core": {
      "types": "./dist/core/src/index.d.ts",
      "default": "./dist/core/src/index.js"
    },
    "./icons/*": {
      "types": "./dist/triolet/src/icons/*.d.ts",
      "default": "./dist/triolet/src/icons/*.js"
    },
    "./triolet.css": "./dist/triolet.css",
    "./svg/*": "./svg/*"
  },
  "files": [
    "dist",
    "svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node ../../tools/build-packages.ts triolet"
  }
}

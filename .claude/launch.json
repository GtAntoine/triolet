{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "spike-web",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "tools/serve.ts",
        "spikes/web",
        "4173"
      ],
      "port": 4173
    },
    {
      "name": "expo-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "examples/expo",
        "run",
        "web",
        "--",
        "--port",
        "8088"
      ],
      "port": 8088
    },
    {
      "name": "site",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--filter",
        "triolet-site",
        "preview",
        "--port",
        "4321"
      ],
      "port": 4321
    }
  ]
}

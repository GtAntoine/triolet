{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "rewriteRelativeImportExtensions": false,
    "allowImportingTsExtensions": true,
    "paths": {
      "triolet/core": ["./packages/core/src/index.ts"],
      "triolet/runtime": ["./packages/triolet/src/runtime.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/triolet-react-native/test/*.ts"],
  "exclude": ["packages/*/src/icons", "packages/*/src/index.ts", "packages/*/src/index.web.ts", "packages/*/src/**/*.tsx"]
}

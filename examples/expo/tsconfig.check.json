// Type-checks the app together with the sources of triolet-react-native. Metro reads tsconfig.json,
// which must not carry these path mappings (it would resolve "react" to its type package).
{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "paths": {
      "triolet-react-native": [
        "../../packages/triolet-react-native/src/index.ts"
      ],
      "triolet-react": [
        "../../packages/triolet-react/dist/index.d.ts"
      ],
      "triolet/core": [
        "../../packages/triolet/dist/core/src/index.d.ts"
      ],
      "triolet/icons/*": [
        "../../packages/triolet/dist/triolet/src/icons/*.d.ts"
      ],
      "react-native": [
        "./node_modules/react-native/types_generated/index.d.ts"
      ],
      "*": [
        "./node_modules/@types/*",
        "./node_modules/*"
      ]
    }
  },
  "include": [
    "index.ts",
    "boot.ts",
    "boot.web.ts",
    "App.tsx",
    "../../packages/triolet-react-native/src"
  ]
}
